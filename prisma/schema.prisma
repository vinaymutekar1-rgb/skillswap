// SHOGO:CUSTOM-START prisma-header
// Managed by Shogo. Do not add a datasource `url` or change the generator `provider` — the database URL is configured in prisma.config.ts (Prisma 7+).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
// SHOGO:CUSTOM-END

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------------
// SkillSwap domain models
// ---------------------------------------------------------------------------

model Student {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  initials         String
  campus           String
  year             String
  bio              String   @default("")
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  credits          Int      @default(0)
  sessionsDone     Int      @default(0)
  availability     String   @default("") // comma separated slots
  preferredMode    String   @default("flexible") // online | offline | flexible
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("students")
}

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  category String @default("General")

  @@map("skills")
}

model StudentSkill {
  id        String @id @default(cuid())
  studentId String
  skillName String
  kind      String // "teach" | "learn"
  level     String @default("intermediate") // beginner | intermediate | advanced
  verified  Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([studentId, skillName, kind])
  @@index([studentId])
  @@index([skillName])

  @@map("student_skills")
}

model SwapRequest {
  id         String   @id @default(cuid())
  fromId     String
  toId       String
  teachSkill String
  learnSkill String
  matchScore Int      @default(0)
  message    String   @default("")
  status     String   @default("pending") // pending | accepted | rejected | completed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromId])
  @@index([toId])

  @@map("swap_requests")
}

model Message {
  id        String   @id @default(cuid())
  requestId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  @@index([requestId])

  @@map("messages")
}

model Session {
  id            String   @id @default(cuid())
  requestId     String
  teacherId     String
  learnerId     String
  skill         String
  scheduledAt   DateTime
  durationMin   Int      @default(60)
  mode          String   @default("online") // online | offline
  status        String   @default("scheduled") // scheduled | completed | cancelled
  creditsAwarded Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([teacherId])
  @@index([learnerId])
  @@index([requestId])

  @@map("sessions")
}

model Review {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  reviewerId    String
  revieweeId    String
  communication Int      @default(5)
  knowledge     Int      @default(5)
  reliability   Int      @default(5)
  quality       Int      @default(5)
  comment       String   @default("")
  createdAt     DateTime @default(now())

  @@index([revieweeId])

  @@map("reviews")
}

model ProgressEntry {
  id        String   @id @default(cuid())
  studentId String
  skill     String
  level     String   @default("beginner")
  hours     Float    @default(0)
  sessions  Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([studentId, skill])

  @@map("progress_entries")
}

model Notification {
  id        String   @id @default(cuid())
  studentId String
  type      String   @default("info") // info | request | message | session | credit
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId])

  @@map("notifications")
}
